              ]
            }
          },
          "response": []
        },
        {
          "name": "PUT Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200 OK\", () => pm.response.to.have.status(200));\r\npm.test(\"Цена изменилась на 200\", () => pm.expect(pm.response.json().totalprice).to.eql(200));\r\npm.test(\"Поле additionalneeds обновилось\", () => pm.expect(pm.response.json().additionalneeds).to.eql(\"Lunch\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Cookie",
                "value": "token={{token}}"
              }
            ],

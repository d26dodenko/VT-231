  "item": [
    {
      "name": "Booking",
      "item": [
        {
          "name": "POST /booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200 OK\", () => pm.response.to.have.status(200));\r\n\r\npm.test(\"Время ответа < 2000 мс\", () => pm.expect(pm.response.responseTime).to.be.below(2000));\r\n\r\npm.test(\"Есть bookingid и он сохранен\", () => {\r\n    let jsonData = pm.response.json();\r\n    pm.expect(jsonData).to.have.property(\"bookingid\");\r\n    // хранениеID бронирования в переменную\r\n    pm.environment.set(\"bookingId\", jsonData.bookingid);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"firstname\": \"Angelika\",\r\n    \"lastname\": \"Chumachenko\",\r\n    \"totalprice\": 150,\r\n    \"depositpaid\": true,\r\n    \"bookingdates\": {\r\n        \"checkin\": \"2024-05-01\",\r\n        \"checkout\": \"2024-05-05\"\r\n    },\r\n    \"additionalneeds\": \"Breakfast\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200 OK\", () => pm.response.to.have.status(200));\r\n\r\npm.test(\"Время ответа < 2000 мс\", () => pm.expect(pm.response.responseTime).to.be.below(2000));\r\n\r\npm.test(\"Имя совпадает\", () => {\r\n    pm.expect(pm.response.json().firstname).to.eql(\"Angelika\");\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [

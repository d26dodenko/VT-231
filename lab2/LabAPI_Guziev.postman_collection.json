      "item": [
        {
          "name": "01 - Valid Auth",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус ответа 200\", function () { pm.response.to.have.status(200); });\npm.test(\"Ответ содержит непустой токен\", function () { const data = pm.response.json(); pm.expect(data.token).to.be.a(\"string\").and.not.empty; });\npm.test(\"Ответ имеет JSON-формат\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });\npm.test(\"Время ответа меньше 5000 мс\", function () { pm.expect(pm.response.responseTime).to.be.below(5000); });\nif (pm.response.code === 200) { const data = pm.response.json(); if (data.token) pm.environment.set(\"token\", data.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
